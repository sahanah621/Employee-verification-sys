# Used strictly for automated integration tests and local development scripts
BACKEND_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# IPFS Configuration (Placeholders for Step 4)
