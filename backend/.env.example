# WorkProof Backend Environment Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Ethereum Blockchain Provider & Contract Configuration
# Local Hardhat development node: http://127.0.0.1:8545
